<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>termrest</AssemblyName>
    <RootNamespace>TermRest.Cli</RootNamespace>
    <!-- Native AOT single-file executable per RID: dotnet publish -r win-x64 -c Release -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <StripSymbols>true</StripSymbols>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TermRest.Core\TermRest.Core.csproj" />
    <ProjectReference Include="..\TermRest.Tui\TermRest.Tui.csproj" />
  </ItemGroup>

  <!--
    Terminal.Gui depends on TextMateSharp, whose native Oniguruma library is only loaded by the syntax-highlighting
    Code/Markdown views. TermRest does not use them, so keep the published app a single executable.
  -->
  <Target Name="RemoveUnusedNativeLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'libonigwrap' or '%(Filename)' == 'onigwrap'" />
    </ItemGroup>
  </Target>

</Project>
