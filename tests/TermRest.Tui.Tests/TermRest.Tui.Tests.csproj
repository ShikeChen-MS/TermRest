<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TermRest.Core\TermRest.Core.csproj" />
    <ProjectReference Include="..\..\src\TermRest.Tui\TermRest.Tui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\samples\**\*.json" Link="samples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared test PKI and HTTPS echo server. -->
    <Compile Include="..\TermRest.Core.Tests\Infrastructure\TestPki.cs" Link="Infrastructure\Shared\TestPki.cs" />
    <Compile Include="..\TermRest.Core.Tests\Infrastructure\EchoServer.cs" Link="Infrastructure\Shared\EchoServer.cs" />
  </ItemGroup>

</Project>
