<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TermRest.Core\TermRest.Core.csproj" />
    <ProjectReference Include="..\..\src\TermRest.Tui\TermRest.Tui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\samples\**\*.json" Link="samples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared test PKI, HTTPS echo server, temp files and the Postman v3 workspace fixture. -->
    <Compile Include="..\TermRest.Core.Tests\Infrastructure\TestPki.cs" Link="Infrastructure\Shared\TestPki.cs" />
    <Compile Include="..\TermRest.Core.Tests\Infrastructure\EchoServer.cs" Link="Infrastructure\Shared\EchoServer.cs" />
    <Compile Include="..\TermRest.Core.Tests\Infrastructure\TestFiles.cs" Link="Infrastructure\Shared\TestFiles.cs" />
    <Compile Include="..\TermRest.Core.Tests\Infrastructure\TempDirectoryCleanup.cs" Link="Infrastructure\Shared\TempDirectoryCleanup.cs" />
    <Compile Include="..\TermRest.Core.Tests\Infrastructure\V3Fixture.cs" Link="Infrastructure\Shared\V3Fixture.cs" />
    <Compile Include="..\TermRest.Core.Tests\Infrastructure\TestPython.cs" Link="Infrastructure\Shared\TestPython.cs" />
    <Compile Include="..\TermRest.Core.Tests\Infrastructure\TestJavaScript.cs" Link="Infrastructure\Shared\TestJavaScript.cs" />
    <Compile Include="..\TermRest.Core.Tests\Infrastructure\TestCSharp.cs" Link="Infrastructure\Shared\TestCSharp.cs" />
    <Compile Include="..\TermRest.Core.Tests\Infrastructure\TestPowerShell.cs" Link="Infrastructure\Shared\TestPowerShell.cs" />
  </ItemGroup>

</Project>
